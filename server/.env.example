SUPABASE_URL=https://your-project-id.supabase.co
# Service role key: server only, never put it in the web app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated list of web app origins allowed to call the service
ALLOWED_ORIGIN=http://localhost:5173,https://your-app.vercel.app
MAX_DURATION_SECONDS=900
